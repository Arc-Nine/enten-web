---
import Icon from './Icon.astro';
---
<section class="hero-track" aria-labelledby="hero-title">
 <div class="hero">
  <img id="hero-image" class="hero-image" src="/images/hero-poster.jpg" width="1280" height="720" alt="" fetchpriority="high" decoding="sync" />
  <div class="hero-content">
    <p class="eyebrow">JAMU TRADISIONAL<br />UNTUK HARI INI</p>
    <h1 id="hero-title">Warisan rasa.<br />Teman keseharian.</h1>
    <a class="button cream" href="#racikan">Jelajahi Racikan <Icon /></a>
  </div>
  <button class="motion-toggle" aria-controls="hero-image" aria-pressed="true" hidden>Nonaktifkan gerak</button>
  <span class="hero-footnote">BERAKAR PADA TRADISI. HADIR UNTUK HARI INI.</span>
  <span class="scroll-hint" aria-hidden="true">GULIR UNTUK MENJELAJAH ↓</span>
 </div>
</section>

