---
import { about, tagline } from '../../data/profile';
---
<section
  id="beranda"
  data-header-theme="dark"
  class="grain relative flex min-h-dvh flex-col justify-between gap-y-2 overflow-hidden bg-forest-950 pt-24 pb-8 text-cream-100 md:pt-[5rem] md:pb-5 short-screen:pt-[4rem] short-screen:pb-2"
>
  <!-- Lapisan ambient: gradasi hutan + cahaya turmeric -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(120% 85% at 82% -10%, rgb(202 152 79 / 0.2) 0%, transparent 55%),
      radial-gradient(90% 70% at 8% 108%, rgb(96 92 72 / 0.6) 0%, transparent 60%),
      linear-gradient(180deg, #605c48 0%, #3b372c 100%);"
    aria-hidden="true"
  ></div>

  <!-- Ornamen botani lapis 1 (paling lambat) -->
  <svg
    data-parallax="6"
    class="pointer-events-none absolute -top-10 -right-24 w-[34rem] opacity-[0.14] md:w-[46rem]"
    viewBox="0 0 400 400"
    fill="none"
    aria-hidden="true"
  >
    <g stroke="#dcb571" stroke-width="1.1" stroke-linecap="round">
      <path d="M330 380C300 260 250 160 140 60" />
      <path d="M262 236c-52 8-92-6-118-44 46-14 88-2 118 44Z" />
      <path d="M232 178c-50-2-84-22-100-64 48-6 84 16 100 64Z" />
      <path d="M204 128c-42-12-66-40-68-84 44 6 68 36 68 84Z" />
      <path d="M292 300c-54 0-92-18-114-58 48-10 88 6 114 58Z" />
      <path d="M176 92c-30-18-44-44-42-78 34 12 48 40 42 78Z" />
    </g>
  </svg>

  <!-- Ornamen botani lapis 2 (lebih cepat) -->
  <svg
    data-parallax="-9"
    class="pointer-events-none absolute top-1/3 -left-28 w-[26rem] opacity-[0.1] md:w-[34rem]"
    viewBox="0 0 300 300"
    fill="none"
    aria-hidden="true"
  >
    <g stroke="#cbb298" stroke-width="1" stroke-linecap="round">
      <path d="M40 280C70 190 120 110 230 40" />
      <path d="M118 168c40 6 70-4 90-34-36-10-68 0-90 34Z" />
      <path d="M146 122c38-2 64-18 76-50-36-4-64 12-76 50Z" />
      <path d="M92 214c42 0 72-14 88-46-38-8-68 4-88 46Z" />
    </g>
  </svg>

  <div class="relative z-10 mx-auto w-full max-w-[86rem] px-5 md:px-10">
    <p class="hero-meta eyebrow text-turmeric-300">Company Profile · Kota Bekasi</p>

    <h1 class="hero-title mt-4 font-display text-[clamp(2.5rem,4.8vw,4.4rem)] leading-[1.02] font-medium tracking-[-0.01em] md:mt-5 short-screen:mt-2 short-screen:text-[clamp(2rem,3.2vw,2.7rem)]">
      <span class="mask-line"><span>Perusahaan di balik</span></span>
      <span class="mask-line"><span class="text-turmeric-300 italic">racikan Enten.</span></span>
    </h1>

    <div class="mt-5 flex flex-col gap-5 md:mt-6 lg:flex-row lg:items-end lg:justify-between lg:gap-10 short-screen:mt-2 short-screen:gap-2">
      <p class="hero-meta max-w-xl text-base leading-relaxed text-cream-100/75 md:text-[1.05rem] short-screen:max-w-lg short-screen:text-[0.9rem] short-screen:leading-snug">
        {about.lead}
      </p>
      <div class="hero-meta flex flex-wrap items-center gap-3 md:gap-4">
        <a class="btn-lux btn-primary" data-magnetic href="#profil">
          <span class="btn-fill" aria-hidden="true"></span>
          Kenali Perusahaan
        </a>
        <a class="btn-lux btn-ghost-dark" data-magnetic href="#racikan">
          <span class="btn-fill" aria-hidden="true"></span>
          Jelajahi Racikan
        </a>
      </div>
    </div>
  </div>

  <!-- Foto produk selebar kolom konten. Desktop: bingkai sinematik lebar dengan
       object-position bawah — bagian atas foto hanya dinding kosong, sehingga
       kelima botol + tangan selalu utuh pada semua tinggi layar. Mobile: crop
       art-direction botol+tangan, rasio asli tanpa pemotongan CSS. -->
  <div class="relative z-10 mx-auto mt-7 w-full max-w-[86rem] px-5 md:mt-8 md:px-10 short-screen:mt-2">
    <figure data-parallax="5" class="hero-meta overflow-hidden rounded-[1.6rem] border border-cream-100/12 will-change-transform">
      <picture>
        <source media="(max-width: 767px)" srcset="/images/profile/hero-mobile.webp" width="1200" height="896" />
        <img
          src="/images/profile/hero.webp"
          alt="Tangan memilih botol Pokak Jahe dari jajaran lima varian Enten: Kunyit Asem, Beras Kencur, Pokak Jahe, Mpon Mpon, dan Lemon Jahe."
          width="2400"
          height="1112"
          class="block w-full object-cover object-bottom max-md:h-auto md:h-[clamp(18rem,44vh,30rem)] short-screen:h-[clamp(19rem,50vh,24rem)]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
    <div class="hero-meta mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[0.7rem] tracking-[0.3em] uppercase md:mt-5 short-screen:mt-2">
      <span class="text-cream-100/60" translate="no">{tagline}</span>
      <span class="flex items-center gap-3 text-cream-100/60">
        Scroll untuk menjelajah
        <svg width="14" height="22" viewBox="0 0 14 22" fill="none" aria-hidden="true">
          <path d="M7 1v16m0 0 5-5m-5 5-5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>
</section>
