---
import { history } from '../../data/profile';
---
<section id="sejarah" data-header-theme="light" class="relative overflow-hidden bg-cream-200 py-24 md:py-36">
  <div class="mx-auto max-w-[86rem] px-5 md:px-10">
    <div class="max-w-3xl" data-reveal-group>
      <p class="eyebrow text-turmeric-600" data-reveal>Sejarah Perusahaan</p>
      <h2 class="mt-6 font-display text-[clamp(2.2rem,4.4vw,3.6rem)] leading-[1.05] font-medium text-forest-900" data-reveal>
        Perjalanan yang dimulai dari niat, <span class="italic">tumbuh bersama kemitraan.</span>
      </h2>
    </div>

    <div class="relative mt-16 md:mt-24">
      <div class="timeline-line" aria-hidden="true"></div>
      <ol class="space-y-14 md:space-y-20">
        {history.map((h, i) => (
          <li class="relative pl-10 md:pl-0" data-reveal-group>
            <span class="timeline-dot" aria-hidden="true"></span>
            <div class={`md:grid md:grid-cols-2 md:gap-16 ${i % 2 === 1 ? '' : ''}`}>
              <div class={i % 2 === 0 ? 'md:pr-16 md:text-right' : 'md:col-start-2 md:pl-16'}>
                <p class="text-[0.7rem] font-semibold tracking-[0.3em] text-turmeric-600 uppercase" data-reveal>
                  {h.phase}
                </p>
                <h3 class="mt-3 font-display text-[1.7rem] leading-tight font-medium text-forest-900" data-reveal>
                  {h.title}
                </h3>
                <p class="mt-4 max-w-xl text-[0.98rem] leading-[1.85] text-ink-700 md:ml-auto" data-reveal>
                  {h.text}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
