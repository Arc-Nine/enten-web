---
import { production, events, specialPackaging } from '../../data/profile';
---
<section id="produksi" data-header-theme="light" class="relative bg-cream-100 py-24 md:py-36">
  <div class="mx-auto max-w-[86rem] px-5 md:px-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal-group>
      <div>
        <p class="eyebrow text-turmeric-600" data-reveal>Produksi & Kegiatan</p>
        <h2 class="mt-6 max-w-2xl text-balance font-display text-[clamp(2.2rem,4.4vw,3.6rem)] leading-[1.05] font-medium text-forest-900" data-reveal>
          Dapur produksi yang rapi, <span class="italic">panggung yang ramai.</span>
        </h2>
      </div>
      <p class="max-w-md text-[0.98rem] leading-[1.85] text-ink-700" data-reveal>{production.text}</p>
    </div>

    <!-- Produksi -->
    <figure class="mt-14 overflow-hidden rounded-[1.6rem]" data-reveal>
      <img
        src={production.image}
        alt={production.imageAlt}
        width="1376"
        height="768"
        class="h-[42vh] w-full object-cover transition-transform duration-[1.6s] [transition-timing-function:var(--ease-lux)] hover:scale-[1.03] md:h-[62vh]"
        loading="lazy"
      />
    </figure>

    <!-- Kegiatan: bazar & pameran + kemasan khusus -->
    <div class="mt-16 grid gap-x-10 gap-y-12 md:mt-24 lg:grid-cols-[1.282fr_1fr] lg:gap-x-14">
      <div class="order-1 lg:order-none lg:col-start-1 lg:row-start-1" data-reveal>
        <h3 class="eyebrow text-turmeric-600">Event yang Pernah Diikuti</h3>
        <p class="mt-5 max-w-xl text-[0.98rem] leading-[1.85] text-ink-700">{events.text}</p>
      </div>

      <figure class="order-2 lg:order-none lg:col-start-1 lg:row-start-2" data-reveal>
        <div class="rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-2 md:p-3 lg:h-full">
          <div class="overflow-hidden rounded-[1.1rem] lg:h-full">
            <img
              src={events.image}
              alt={events.imageAlt}
              width="1080"
              height="1080"
              class="aspect-square w-full object-cover transition-transform duration-[1.6s] [transition-timing-function:var(--ease-lux)] hover:scale-[1.03] lg:aspect-auto lg:h-full"
              loading="lazy"
            />
          </div>
        </div>
      </figure>

      <div class="order-3 lg:order-none lg:col-start-2 lg:row-start-1" data-reveal>
        <h3 class="eyebrow text-turmeric-600">Event-Event Khusus</h3>
        <p class="mt-5 text-[0.98rem] leading-[1.85] text-ink-700">{specialPackaging.text}</p>
      </div>

      <figure class="order-4 lg:order-none lg:col-start-2 lg:row-start-2" data-reveal>
        <div class="rounded-[1.5rem] border border-forest-900/10 bg-cream-50 p-2 md:p-3 lg:h-full">
          <div class="overflow-hidden rounded-[1.1rem] lg:h-full">
            <img
              src={specialPackaging.image}
              alt={specialPackaging.imageAlt}
              width="2632"
              height="3374"
              class="aspect-[2632/3374] w-full object-cover transition-transform duration-[1.6s] [transition-timing-function:var(--ease-lux)] hover:scale-[1.03] lg:aspect-auto lg:h-full"
              loading="lazy"
            />
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>
