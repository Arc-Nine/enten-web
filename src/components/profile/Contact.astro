---
import { contact, createWhatsAppUrl } from '../../data/profile';
const waUrl = createWhatsAppUrl(
  'Halo Enten, saya ingin mengenal racikan Enten dan peluang kemitraan Sabrang Malsico.',
);
---
<section
  id="kontak"
  data-header-theme="dark"
  class="grain relative overflow-hidden bg-forest-950 py-24 text-cream-100 md:py-36"
>
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(90% 70% at 85% 0%, rgb(202 152 79 / 0.16) 0%, transparent 55%);"
    aria-hidden="true"
  ></div>
  <div class="relative z-10 mx-auto max-w-[86rem] px-5 md:px-10">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6" data-reveal-group>
        <p class="eyebrow text-turmeric-300" data-reveal>Kontak Kami</p>
        <h2 class="mt-6 font-display text-[clamp(2.3rem,4.6vw,3.8rem)] leading-[1.04] font-medium" data-reveal>
          Mari berkenalan, <span class="text-turmeric-300 italic">mulai dari satu sapaan.</span>
        </h2>
        <p class="mt-7 max-w-lg text-[0.98rem] leading-[1.85] text-cream-100/70" data-reveal>
          Untuk pemesanan, kemitraan, maupun undangan event, sapa kami melalui kanal resmi berikut.
          Pesan WhatsApp terbuka sebagai draf — Anda memeriksa dan mengirimnya sendiri.
        </p>
        <a class="btn-lux btn-primary mt-10" data-magnetic href={waUrl} target="_blank" rel="noopener noreferrer" data-reveal>
          <span class="btn-fill" aria-hidden="true"></span>
          Hubungi via WhatsApp
        </a>
        <p class="mt-4 max-w-md text-[0.72rem] leading-relaxed text-cream-100/45" data-reveal>
          {contact.whatsappNote}
        </p>
      </div>

      <ul class="grid gap-px overflow-hidden rounded-[1.4rem] border border-cream-100/12 bg-cream-100/12 sm:grid-cols-2 lg:col-span-5 lg:col-start-8" data-reveal-group>
        <li class="bg-forest-950/85 p-7" data-reveal>
          <p class="text-[0.68rem] font-semibold tracking-[0.3em] text-turmeric-300 uppercase">WhatsApp</p>
          <a class="mt-3 block font-display text-2xl italic transition-colors duration-300 hover:text-turmeric-300" href={waUrl} target="_blank" rel="noopener noreferrer">
            {contact.whatsappDisplay}
          </a>
        </li>
        <li class="bg-forest-950/85 p-7" data-reveal>
          <p class="text-[0.68rem] font-semibold tracking-[0.3em] text-turmeric-300 uppercase">Email</p>
          <a class="mt-3 block break-words font-display text-2xl italic transition-colors duration-300 hover:text-turmeric-300" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        </li>
        <li class="bg-forest-950/85 p-7" data-reveal>
          <p class="text-[0.68rem] font-semibold tracking-[0.3em] text-turmeric-300 uppercase">Instagram</p>
          <a class="mt-3 block font-display text-2xl italic transition-colors duration-300 hover:text-turmeric-300" href={contact.instagramUrl} target="_blank" rel="noopener noreferrer">
            {contact.instagram}
          </a>
        </li>
        <li class="bg-forest-950/85 p-7" data-reveal>
          <p class="text-[0.68rem] font-semibold tracking-[0.3em] text-turmeric-300 uppercase">TikTok</p>
          <a class="mt-3 block font-display text-2xl italic transition-colors duration-300 hover:text-turmeric-300" href={contact.tiktokUrl} target="_blank" rel="noopener noreferrer">
            {contact.tiktok}
          </a>
        </li>
        <li class="bg-forest-950/85 p-7 sm:col-span-2" data-reveal>
          <p class="text-[0.68rem] font-semibold tracking-[0.3em] text-turmeric-300 uppercase">Lokasi</p>
          <p class="mt-3 font-display text-2xl italic">{contact.location}</p>
        </li>
      </ul>
    </div>
  </div>
</section>
