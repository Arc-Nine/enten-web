---
// Beranda — company profile Sabrang Malsico (ENTEN Herbal Drink).
// 8 section: Hero, Profil+Visi&Misi, Sejarah, Produksi & Kegiatan,
// Varian Produk (pinned horizontal), Kemitraan & Pengiriman, Kontak, Footer.
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '../styles/profile.css';
import Header from '../components/profile/Header.astro';
import Hero from '../components/profile/Hero.astro';
import Marquee from '../components/profile/Marquee.astro';
import About from '../components/profile/About.astro';
import History from '../components/profile/History.astro';
import Production from '../components/profile/Production.astro';
import Variants from '../components/profile/Variants.astro';
import Partnership from '../components/profile/Partnership.astro';
import Contact from '../components/profile/Contact.astro';
import Footer from '../components/profile/Footer.astro';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sabrang Malsico — ENTEN Herbal Drink | Company Profile</title>
    <meta
      name="description"
      content="Company profile Sabrang Malsico, perusahaan minuman herbal tradisional dari Kota Bekasi dengan merek ENTEN. Kenali profil, sejarah, produksi, lima racikan, kemitraan, dan kontak kami."
    />
    <meta name="theme-color" content="#605c48" />
    <link rel="icon" type="image/png" href="/images/enten-logo-turmeric.png" />
    <script is:inline>
      // Aktifkan state awal animasi hanya bila gerak diizinkan.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ready');
      }
    </script>
  </head>
  <body>
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <Hero />
      <Marquee />
      <About />
      <History />
      <Production />
      <Variants />
      <Partnership />
      <Contact />
      <Footer />
    </main>
    <script>
      import '../scripts/profile';
    </script>
  </body>
</html>
